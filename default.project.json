{
  "name": "CITY_RUSH",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 45,
        "CameraMinZoomDistance": 8
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512,
        "Gravity": 140,
        "FallenPartsDestroyHeight": -200
      }
    },
    "AssetService": {
      "$className": "AssetService",
      "$properties": {
        "AllowInsertFreeAssets": true
      }
    }
  }
}
